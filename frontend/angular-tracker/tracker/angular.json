{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "tracker": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "tracker:esbuild:production",
            "federationConfig": "federation.config.js", 
            "cacheExternalArtifacts": false,
            "tsConfig": "tsconfig.federation.json",
            "skipRemoteChecking": true
          },
          "configurations": {
            "production": {
              "target": "tracker:esbuild:production",
              "dev": false
            },
            "development": {
              "target": "tracker:esbuild:development",
              "dev": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "tracker:serve-original:development",
            "federationConfig": "federation.config.js", 
            "rebuildDelay": 500,
            "dev": true,
            "devServer": true,
            "port": 5004,
            "headers": {
              "Access-Control-Allow-Origin": "*",
              "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
              "Access-Control-Allow-Headers": "Origin, X-Requested-With, Content-Type, Accept"
            }
          }
        },
        "esbuild": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist-app/tracker",
            "index": "src/index.html",
            "polyfills": ["src/polyfills.ts", "es-module-shims"],
            "tsConfig": "tsconfig.app.json",
            "assets": [],
            "styles": ["src/styles.css"],
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "production": {
              "optimization": true,
              "extractLicenses": true,
              "sourceMap": false
            }
          },
          "defaultConfiguration": "development"
        },
        "serve-original": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 5004,
            "buildTarget": "tracker:esbuild:development",
            "headers": {
              "Access-Control-Allow-Origin": "*",
              "Access-Control-Allow-Methods": "GET, POST, PUT, DELETE, OPTIONS",
              "Access-Control-Allow-Headers": "Origin, X-Requested-With, Content-Type, Accept"
            }
          },
          "configurations": {
            "development": {
              "buildTarget": "tracker:esbuild:development"
            },
            "production": {
              "buildTarget": "tracker:esbuild:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}